# Telegram Bot
BOT_ENV=test
TEST_BOT_TOKEN=your_test_bot_token_here
PROD_BOT_TOKEN=your_prod_bot_token_here

# Database
# Leave DATABASE_URL empty to build it from POSTGRES_* variables.
DATABASE_URL=
GOOSE=goose
GOOSE_DRIVER=postgres
MIGRATIONS_DIR=migrations

# Docker Compose
ENV_FILE=.env
DOCKER_BUILD_CONTEXT=.
DOCKERFILE=Dockerfile
GO_VERSION=1.26.1
ALPINE_VERSION=3.22
DOCKER_LOG_PRETTY=false
DOCKER_MIGRATIONS_DIR=/app/migrations

# Docker Compose: Postgres
POSTGRES_VERSION=17-alpine
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_DB=bakery
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_SSLMODE=disable
POSTGRES_VOLUME=postgres_data
POSTGRES_HEALTHCHECK_INTERVAL=5s
POSTGRES_HEALTHCHECK_TIMEOUT=5s
POSTGRES_HEALTHCHECK_RETRIES=10

# Docker Compose: services
ORDERBOT_APP=orderbot
SYNC_APP=sync
CREATEADMIN_APP=createadmin
ORDERBOT_RESTART=unless-stopped
SYNC_RESTART=unless-stopped
TOOLS_PROFILE=tools

# Admin user
ADMIN_USERNAME=admin
ADMIN_PASSWORD=123

# iiko Resto API
IIKO_HOST=your-server.iiko.it
IIKO_PORT=443
IIKO_LOGIN=your_login
IIKO_PASSWORD=your_password

# Logging
LOG_LEVEL=INFO
LOG_PRETTY=true
LOG_DIR=

# iiko sync
SYNC_INTERVAL=6h
