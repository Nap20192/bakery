# Telegram Bot
BOT_ENV=test
TEST_BOT_TOKEN=
PROD_BOT_TOKEN=
# Public HTTPS URL of the deployed service opened inside Telegram.
MINI_APP_URL=
# Optional Telegram group/supergroup chat ID for workshop notifications.
# Add the bot to the group, send any message there, then read chat.id from getUpdates.
TELEGRAM_WORKSHOP_CHAT_ID=

# Database: SQLite file (on Railway — on the mounted volume, e.g. /data/bakery.db)
SQLITE_PATH=data/bakery.db
# One-time import: when set and SQLITE_PATH does not exist, copy all data from
# this Postgres on startup. Remove after the move.
IMPORT_POSTGRES_URL=

# Admin user created on startup if missing.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# iiko Resto API
IIKO_HOST=
IIKO_PORT=443
IIKO_LOGIN=
IIKO_PASSWORD=

# Logging
LOG_LEVEL=INFO
LOG_PRETTY=false
LOG_DIR=

# App
MIGRATIONS_DIR=migrations
SYNC_INTERVAL=6h
ORDER_CLEANUP_INTERVAL=24h
ORDER_RETENTION=744h
HTTP_HOST=
PORT=8080
HTTP_SHUTDOWN_TIMEOUT=10s
