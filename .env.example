# Telegram Bot
ORDER_BOT_TOKEN=your_order_bot_token_here

# Database
DATABASE_URL=postgres://postgres:postgres@localhost:5432/bakery?sslmode=disable
GOOSE=goose
GOOSE_DRIVER=postgres
MIGRATIONS_DIR=migrations

# Admin user
ADMIN_USERNAME=admin
ADMIN_PASSWORD=123

# iiko Resto API
IIKO_HOST=your-server.iiko.it
IIKO_PORT=443
IIKO_LOGIN=your_login
IIKO_PASSWORD=your_password

# Logging
LOG_LEVEL=INFO
LOG_PRETTY=true
LOG_DIR=

# iiko sync
SYNC_INTERVAL=6h
SYNC_DATE_FROM=2026-05-06
SYNC_DATE_TO=2026-05-06
