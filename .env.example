# Telegram Bot
BOT_ENV=test
TEST_BOT_TOKEN=
PROD_BOT_TOKEN=

# Local/Postgres
POSTGRES_VERSION=latest
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=bakery
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_SSLMODE=disable
POSTGRES_VOLUME=postgres_data

# Docker
GO_IMAGE=golang:alpine
RUNTIME_IMAGE=alpine:latest

# Admin user created by worker on startup if missing.
ADMIN_PASSWORD=

# iiko Resto API
IIKO_HOST=
IIKO_LOGIN=
IIKO_PASSWORD=

# Logging
LOG_PRETTY=false
