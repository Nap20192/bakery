# Telegram Bot
BOT_ENV=test
TEST_BOT_TOKEN=
PROD_BOT_TOKEN=

# Database
DATABASE_URL=
POSTGRES_VERSION=17-alpine
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=bakery
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_SSLMODE=disable
POSTGRES_VOLUME=postgres_data
POSTGRES_HEALTHCHECK_INTERVAL=5s
POSTGRES_HEALTHCHECK_TIMEOUT=5s
POSTGRES_HEALTHCHECK_RETRIES=10

# Docker
DOCKER_BUILD_CONTEXT=.
DOCKERFILE=Dockerfile
GO_IMAGE=golang:alpine
RUNTIME_IMAGE=alpine:latest
DOCKER_LOG_PRETTY=false
DOCKER_MIGRATIONS_DIR=/app/migrations
WORKER_RESTART=unless-stopped

# Admin user created by worker on startup if missing.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# iiko Resto API
IIKO_HOST=
IIKO_PORT=443
IIKO_LOGIN=
IIKO_PASSWORD=

# Logging
LOG_LEVEL=INFO
LOG_PRETTY=false
LOG_DIR=

# App
MIGRATIONS_DIR=migrations
SYNC_INTERVAL=6h
HTTP_PORT=8080
HTTP_ALLOWED_ORIGINS=
HTTP_SHUTDOWN_TIMEOUT=10s

# Frontend
VITE_API_BASE_URL=http://localhost:8080
