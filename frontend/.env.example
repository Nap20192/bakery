# Runtime server
HOST=0.0.0.0
PORT=8080
BACKEND_URL=http://bakery.railway.internal:8080
FRONTEND_LOGS=true

# Browser API base.
# Local Vite dev against Go backend: http://localhost:8080
# Runtime frontend server/proxy and Railway: /api
VITE_API_BASE_URL=/api
VITE_FRONTEND_LOGS=true
# Local browser testing only: a signed Telegram WebApp initData string.
VITE_TELEGRAM_INIT_DATA=
# Bot username (without @) for the Telegram Login Widget on the plain-web build.
# Required for web login; the bot domain must be set in @BotFather (/setdomain).
VITE_TELEGRAM_BOT_USERNAME=
