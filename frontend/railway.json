{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "/frontend/Dockerfile",
    "buildEnvironment": "V3",
    "watchPatterns": [
      "/frontend/**",
      "/go.mod",
      "/go.sum"
    ]
  },
  "deploy": {
    "runtime": "V2",
    "numReplicas": 1,
    "sleepApplication": false,
    "useLegacyStacker": false,
    "ipv6EgressEnabled": false,
    "restartPolicyType": "ALWAYS"
  }
}
