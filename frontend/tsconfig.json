{
  // Типпроверка без транспиляции: vite собирает как раньше, `npm run
  // typecheck` проверяет файлы с прагмой // @ts-check (слой src/api) против
  // сгенерированного src/api/schema.d.ts.
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "allowJs": true,
    "checkJs": false,
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true
  },
  "include": ["src/api/**/*"]
}
